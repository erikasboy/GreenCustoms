<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.tagline }}{% endif %}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

  <!-- Desktop Header -->
  <header class="site-header" id="site-header">
    <div class="container header-inner">
      <a href="/" class="logo-link">
        <img src="/images/green-customs-logo.png" alt="Green Customs" class="logo">
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/" class="nav-link{% if page.url == '/' %} active{% endif %}">Home</a></li>
          <li class="has-dropdown">
            <a href="/shop/" class="nav-link{% if '/shop' in page.url %} active{% endif %}">Shop</a>
            <ul class="dropdown">
              <li><a href="/rebuilds/">Rebuilt Electrics</a></li>
              <li><a href="/pickups/">Side Quest Pickups</a></li>
              <li><a href="/acoustics/">Acoustic Guitars</a></li>
            </ul>
          </li>
          <li><a href="/repairs/" class="nav-link{% if page.url == '/repairs/' %} active{% endif %}">Services</a></li>
          <li class="has-dropdown">
            <a href="/about/" class="nav-link{% if page.url == '/about/' %} active{% endif %}">About</a>
            <ul class="dropdown">
              <li><a href="/about/">Our Story</a></li>
              <li><a href="/repairs/">Repair &amp; Restoration</a></li>
              <li><a href="/rebuilds/">Electric Rebuilds</a></li>
              <li><a href="/pickups/">Side Quest Pickups</a></li>
              <li><a href="/acoustics/">Acoustic Builds</a></li>
            </ul>
          </li>
          <li><a href="/contact/" class="nav-link{% if page.url == '/contact/' %} active{% endif %}">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src="/images/green-customs-logo.png" alt="Green Customs" class="logo logo--white">
        <p class="footer-tagline">{{ site.tagline }}</p>
      </div>
      <div class="footer-links">
        <h3>Navigate</h3>
        <ul>
          <li><a href="/shop/">Shop</a></li>
          <li><a href="/repairs/">Repair &amp; Restoration</a></li>
          <li><a href="/rebuilds/">Electric Rebuilds</a></li>
          <li><a href="/pickups/">Side Quest Pickups</a></li>
          <li><a href="/acoustics/">Acoustic Builds</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div class="footer-contact">
        <h3>Get in Touch</h3>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.instagram_url }}" target="_blank" rel="noopener">@{{ site.instagram_business }}</a></li>
          <li><a href="https://instagram.com/{{ site.instagram_personal }}" target="_blank" rel="noopener">@{{ site.instagram_personal }}</a></li>
        </ul>
        <a href="/service-request/" class="btn btn--primary footer-cta">Request a Service</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>&copy; {% year %} Green Customs. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Mobile Bottom Tab Bar -->
  <nav class="mobile-tab-bar" aria-label="Mobile navigation">
    <a href="/" class="tab-item{% if page.url == '/' %} active{% endif %}">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Home</span>
    </a>
    <a href="/shop/" class="tab-item{% if '/shop' in page.url %} active{% endif %}">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <span>Shop</span>
    </a>
    <a href="/repairs/" class="tab-item{% if page.url == '/repairs/' or page.url == '/rebuilds/' or page.url == '/service-request/' %} active{% endif %}">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      <span>Services</span>
    </a>
    <a href="/about/" class="tab-item{% if page.url == '/about/' %} active{% endif %}">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
      <span>About</span>
    </a>
    <a href="/contact/" class="tab-item{% if page.url == '/contact/' %} active{% endif %}">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Contact</span>
    </a>
  </nav>

  <script src="/assets/js/main.js"></script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    // Redirect to /admin/ after identity actions (invite, password reset)
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
