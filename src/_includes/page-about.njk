---
layout: base.njk
---

<section class="page-hero page-hero--dark">
  <div class="container">
    <h1>{{ hero_heading if hero_heading else title }}</h1>
    {% if hero_sub %}<p>{{ hero_sub }}</p>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container content-narrow">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <h2 class="section__heading">What We Do</h2>
    <div class="services-grid services-grid--light">

      <a href="/repairs/" class="service-card service-card--light">
        <div class="service-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3>Repair &amp; Restoration</h3>
        <p>Setups, fret work, crack repair, electronics, and more.</p>
      </a>

      <a href="/rebuilds/" class="service-card service-card--light">
        <div class="service-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </div>
        <h3>Electric Rebuilds</h3>
        <p>Import electrics fully rebuilt — all-new electronics and hardware, ready to gig.</p>
      </a>

      <a href="/pickups/" class="service-card service-card--light">
        <div class="service-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        </div>
        <h3>Side Quest Pickups</h3>
        <p>Hand-wound pickups and pickup repair — singles, P-90 style, and more.</p>
      </a>

      <a href="/acoustics/" class="service-card service-card--light">
        <div class="service-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </div>
        <h3>Acoustic Builds</h3>
        <p>Hand-built acoustic guitars — just getting started. Contact to express interest.</p>
      </a>

    </div>
  </div>
</section>
